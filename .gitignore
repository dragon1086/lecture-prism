# ─────────────────────────────────────────────────────────────
# 시크릿 / 인증 (공개 레포 — 절대 커밋 금지)
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.secrets.yaml
mcp_agent.secrets.yaml

# KIS 등 증권 API 설정: config 디렉토리는 example만 남기고 전부 제외
**/config/*
!**/config/*.example
kis_devlp.yaml
**/.token_key
**/KIS[0-9]*
*.token

# ─────────────────────────────────────────────────────────────
# 로컬 작업 산출물 (강의 운영용 — 공개 레포에 포함 안 함)
# ─────────────────────────────────────────────────────────────
tasks/
.omc/
docs/superpowers/
강의자료/
lecture/archive/
student_inputs/
# 실제 계좌·대시보드 원본. 공개 가능한 슬라이드 HTML은 제외하지 않음.
lecture/slides/assets/

# ─────────────────────────────────────────────────────────────
# 런타임 생성물
# ─────────────────────────────────────────────────────────────
prism.db
*.db
*.cycle-lock
*.classroom-replay-lock
*.log
reports/
trading/**/*.log
trading/**/logs/
trading/**/log/

# ─────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ─────────────────────────────────────────────────────────────
# OS / 에디터
# ─────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
