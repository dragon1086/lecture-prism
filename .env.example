# lecture-prism 런타임 설정 예시
# 실제 키를 넣은 .env 파일은 절대 커밋하지 마세요.
#
# 수강생이 기본적으로 만지는 파일은 두 개입니다.
# 1) .env: 더미/실데이터/리서치/매매 수준 선택
# 2) trading/trading/config/kis_devlp.yaml: KIS 계좌와 App Key 입력

# ─────────────────────────────────────────────────────────────
# 1. 가장 먼저 고르는 학습 프로필
# ─────────────────────────────────────────────────────────────
# mock      : 키/설치 없이 더미 데이터 + 시뮬레이션. 초급자 기본값.
# real_data : yfinance 또는 kospi_kosdaq로 가격/거래량 실데이터만 확장.
# research  : 실데이터 + LLM + Perplexity/Firecrawl 리서치 보고서.
# paper     : research + 증권사 모의투자 주문 경로(demo)를 실험.
# live      : research + 실전투자 경로. 이중 안전 플래그 없이는 차단됨.
LECTURE_PROFILE=mock

# 프로필 기본값을 세부 조정하고 싶을 때만 아래 값을 바꾸세요.
# LECTURE_DATA_MODE=mock
# LECTURE_SCREENING_MODE=mock
# LECTURE_LLM_MODE=mock
# LECTURE_REPORT_MODE=lite
# LECTURE_RESEARCH_TOOLS=""
# LECTURE_TRADE_MODE=simulation
LECTURE_SAVE_REPORTS=1

# 선택값 안내:
# LECTURE_DATA_MODE      = mock | auto | yfinance | kospi_kosdaq
# LECTURE_SCREENING_MODE = mock | pykrx
# LECTURE_LLM_MODE       = mock | auto | oauth | openai
# LECTURE_REPORT_MODE    = lite | research
# LECTURE_RESEARCH_TOOLS = kospi_kosdaq,perplexity,firecrawl
# LECTURE_TRADE_MODE     = simulation | demo | real

# ─────────────────────────────────────────────────────────────
# 2. LLM 분석 연결
# ─────────────────────────────────────────────────────────────
# mock 프로필에서는 아래 키가 있어도 LECTURE_LLM_MODE=mock이면 호출하지 않습니다.
LECTURE_LLM_MODEL=gpt-5.4-mini

# OpenAI API 키 방식
OPENAI_API_KEY=""

# ChatGPT OAuth 프록시 방식
# ChatGPT 구독 계정으로 localhost:18741 프록시를 쓰고 싶을 때:
# LECTURE_LLM_MODE=oauth
# PRISM_OPENAI_AUTH_MODE=chatgpt_oauth
# OPENAI_BASE_URL="http://localhost:18741/v1"
PRISM_OPENAI_AUTH_MODE=""
OPENAI_BASE_URL=""

# ─────────────────────────────────────────────────────────────
# 3. 실데이터 / 리서치 도구
# ─────────────────────────────────────────────────────────────
# yfinance는 키가 없지만 선택 패키지 설치와 인터넷 연결이 필요합니다.
YFINANCE_ENABLED_HINT=1

# kospi_kosdaq_server를 직접 쓸 때. 계정이 없으면 yfinance/mock으로 폴백합니다.
KRX_ID=""
KRX_PW=""
KAKAO_ID=""
KAKAO_PW=""
KOSPI_KOSDAQ_ALLOW_NO_LOGIN=0

# Perplexity Sonar: 최신 뉴스/시장 맥락 보강
PERPLEXITY_API_KEY=""
PERPLEXITY_MODEL=sonar-pro

# Firecrawl: 웹 페이지를 Markdown으로 수집
FIRECRAWL_API_KEY=""

# ─────────────────────────────────────────────────────────────
# 4. 브로커 / 매매 실행
# ─────────────────────────────────────────────────────────────
# 기본값: 기존 KIS 브리지. kiwoom/toss/custom 으로 갈아끼울 수 있습니다.
LECTURE_BROKER=kis
LECTURE_BROKER_MODE=demo

# 안전장치: 0이면 .env에서 paper/live를 골라도 실제 브로커 API 호출을 막습니다.
LECTURE_ENABLE_LIVE_BROKER=0
LECTURE_ALLOW_REAL_BROKER=0

# KIS를 쓸 때는 trading/trading/config/kis_devlp.yaml.example을 복사해
# kis_devlp.yaml을 만들고, 계좌별 App Key/App Secret을 채웁니다.
# 이전 호환 플래그도 유지됩니다.
LECTURE_KIS_MODE=demo
LECTURE_ENABLE_LIVE_KIS=0
LECTURE_ALLOW_REAL_KIS=0

# Kiwoom REST API를 쓸 때
# 공식 문서 기준: mockapi.kiwoom.com / api.kiwoom.com, /oauth2/token, /api/dostk/ordr
KIWOOM_MODE=demo
KIWOOM_APP_KEY="키움_앱키를_여기에"
KIWOOM_SECRET_KEY="키움_시크릿키를_여기에"
# 이미 접근토큰이 있으면 APP_KEY/SECRET 대신 사용할 수 있습니다.
# KIWOOM_ACCESS_TOKEN="키움_접근토큰"
KIWOOM_EXCHANGE=KRX

# Toss Securities를 쓸 때
# 2026-06-28 기준 공개 공식 증권 주문 API를 확인하지 못해 템플릿만 제공합니다.
# 수강생이 파트너/비공개 문서를 가져오면 brokers/toss.py에 실제 엔드포인트를 채웁니다.
TOSS_SECURITIES_MODE=demo
TOSS_SECURITIES_BASE_URL=""
TOSS_SECURITIES_API_KEY=""
TOSS_SECURITIES_ACCOUNT_ID=""

# 완전히 다른 증권사를 붙일 때
# LECTURE_BROKER=custom
# LECTURE_BROKER_ADAPTER=my_broker_module:MyBrokerAdapter
