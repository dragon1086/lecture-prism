# lecture-prism 선택 브로커 설정 예시
# 실제 키를 넣은 .env 파일은 절대 커밋하지 마세요.

# 기본값: 기존 KIS 브리지. kiwoom/toss/custom 으로 갈아끼울 수 있습니다.
LECTURE_BROKER=kis
LECTURE_BROKER_MODE=demo

# 안전장치: 0이면 --live를 눌러도 실제 브로커 API 호출을 막습니다.
LECTURE_ENABLE_LIVE_BROKER=0
LECTURE_ALLOW_REAL_BROKER=0

# KIS를 쓸 때는 기존 trading/trading/config/kis_devlp.yaml.example을 참고합니다.
# 이전 호환 플래그도 유지됩니다.
LECTURE_KIS_MODE=demo
LECTURE_ENABLE_LIVE_KIS=0
LECTURE_ALLOW_REAL_KIS=0

# Kiwoom REST API를 쓸 때
# 공식 문서 기준: mockapi.kiwoom.com / api.kiwoom.com, /oauth2/token, /api/dostk/ordr
KIWOOM_MODE=demo
KIWOOM_APP_KEY="키움_앱키를_여기에"
KIWOOM_SECRET_KEY="키움_시크릿키를_여기에"
# 이미 접근토큰이 있으면 APP_KEY/SECRET 대신 사용할 수 있습니다.
# KIWOOM_ACCESS_TOKEN="키움_접근토큰"
KIWOOM_EXCHANGE=KRX

# Toss Securities를 쓸 때
# 2026-06-28 기준 공개 공식 증권 주문 API를 확인하지 못해 템플릿만 제공합니다.
# 수강생이 파트너/비공개 문서를 가져오면 brokers/toss.py에 실제 엔드포인트를 채웁니다.
TOSS_SECURITIES_MODE=demo
TOSS_SECURITIES_BASE_URL=""
TOSS_SECURITIES_API_KEY=""
TOSS_SECURITIES_ACCOUNT_ID=""

# 완전히 다른 증권사를 붙일 때
# LECTURE_BROKER=custom
# LECTURE_BROKER_ADAPTER=my_broker_module:MyBrokerAdapter
