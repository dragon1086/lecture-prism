# ═══════════════════════════════════════════════════════════════
#  lecture-prism 설정 견본 (.env.example)
# ═══════════════════════════════════════════════════════════════
#
#  ◆ 이 파일 쓰는 법 (README "3. 학습 단계 사다리"와 짝을 이룹니다)
#
#  1) 이 파일은 '견본'입니다. 이 파일을 복사해 .env 라는 이름의
#     파일을 만들면 설정이 적용됩니다.
#     → 코딩 에이전트에게: ".env.example을 복사해서 .env를 만들어줘"
#
#  2) 수업 기본 실습(1단계 mock)은 .env가 없어도 그대로 돌아갑니다.
#     실데이터·실제 AI·모의투자로 "단계를 올릴 때" 처음 만드세요.
#
#  3) 실제 키를 넣은 .env는 절대 GitHub에 올리지 마세요.
#     에이전트에게 기본 텍스트 편집기로 열어 달라고 한 뒤 사람이 직접
#     입력·저장합니다. 채팅에는 키를 붙여넣지 않습니다.
#     .gitignore는 Git 업로드를 막지만 로컬 파일 읽기까지 막지는 않으므로,
#     점검 결과는 준비됨 / 비어 있음 / 형식 오류만 요청하세요.
#
# ═══════════════════════════════════════════════════════════════
#  STEP 1. 학습 단계 고르기 — 대부분 이 한 줄이면 끝
# ═══════════════════════════════════════════════════════════════
#
#  값        단계          무엇이 더 켜지나              필요한 것
#  ─────────────────────────────────────────────────────────────
#  mock      1️⃣ 수업 기본  더미 데이터 + 시뮬레이션      없음
#  real_data 2️⃣ 실데이터   + 실제 가격·거래량(yfinance)  인터넷
#  research  3️⃣ 실제 AI    + LLM 분석·리서치 보고서      STEP 2의 연결 1개
#  paper     4️⃣ 모의투자   + 증권사 모의 주문 연습       STEP 4의 KIS 키
#  live      5️⃣ 실전투자   + 진짜 주문(수업 밖)          STEP 4 안전장치 해제
#
#  키·연결이 부족하면 그 기능만 꺼지고 아래 단계로 자동 폴백합니다.
LECTURE_PROFILE=mock

# 분석 보고서를 reports/ 폴더에 파일로 남길지 (1=저장, 0=끔)
LECTURE_SAVE_REPORTS=1

# 판단 보고 채널 (선택: discord | telegram | both | off)
# 기본은 Discord입니다. 선택한 채널의 값이 모두 있어야 알림을 보냅니다.
# 웹후크·봇 토큰·채널 ID는 .env에만 두고 화면·문서·Git에 올리지 마세요.
LECTURE_REPORT_CHANNEL=discord
DISCORD_WEBHOOK_URL=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHANNEL_ID=""

# 보조 작업 예약 루프 (선택)
# operations.py의 batch·monitor·reconcile·compress를 정해진 시각에 호출합니다.
# 수업에서는 0으로 두고 각 작업을 한 번씩만 실행합니다.
LECTURE_ENABLE_SCHEDULER=0

# 운영 서비스 상태 위치 (선택)
# operations.py schedule이 scheduler.lock, operations-state.json,
# logs/operations-YYYY-MM-DD.log를 저장하는 폴더입니다.
# 비워 두면 운영체제 임시 폴더 아래 lecture-prism 전용 위치를 씁니다.
LECTURE_OPERATIONS_RUNTIME_DIR=

# 운영 서비스 템플릿의 비밀이 아닌 조절값
# monitor/reconcile 간격은 .env 키가 아니라 서비스 템플릿의
# --monitor-interval-minutes / --reconcile-interval-minutes 인자로 조절합니다.
# stale_data는 신선한 quote나 provider 증거가 없을 때 operations.py가 상태와
# 로그에 남기는 실패 사유이며, 현재 .env로 임계값을 바꾸지 않습니다.

# ═══════════════════════════════════════════════════════════════
#  STEP 2. 실제 LLM 연결 — 3단계(research)부터 필요
# ═══════════════════════════════════════════════════════════════
#
#  둘 중 한 가지 방법만 있으면 됩니다.
#
#  방법 A. ChatGPT 구독(Plus/Pro)으로 연결 — API 키 결제 불필요 (수업 권장)
#  Codex CLI에서 최초 1회 로그인한 뒤 아래 한 줄만 켭니다.
#  토큰 저장·자동 갱신은 공식 Codex가 담당하며 이 프로젝트는 인증 파일을 읽지 않습니다.
# LECTURE_LLM_MODE=oauth
# LECTURE_CODEX_MODEL=gpt-5.4-mini
# LECTURE_CODEX_TIMEOUT_SECONDS=180

#  방법 B. OpenAI API 키로 연결 — 유료 과금 계정이 있을 때만
# LECTURE_LLM_MODE=openai
OPENAI_API_KEY=""

#  분석에 사용할 모델 이름
LECTURE_LLM_MODEL=gpt-5.4-mini

# ═══════════════════════════════════════════════════════════════
#  STEP 3. 리서치 도구 키 — 3단계에서 보고서를 더 풍부하게 (선택)
# ═══════════════════════════════════════════════════════════════
#
#  키가 비어 있으면 해당 도구만 조용히 건너뛰고 보고서는 계속 나옵니다.

# Perplexity Sonar — 최신 뉴스·시장 맥락 보강
PERPLEXITY_API_KEY=""
PERPLEXITY_MODEL=sonar-pro

# Firecrawl — 웹 페이지를 Markdown으로 수집
FIRECRAWL_API_KEY=""

# ═══════════════════════════════════════════════════════════════
#  선택 준비 — KIS 수급 숫자 확인 (주문 없음)
# ═══════════════════════════════════════════════════════════════
# Part 3 말미·Part 4 P4-KIS에서 선택한 사람만 입력합니다.
# paper 또는 real 중 하나의 App Key와 App Secret만 채웁니다.
# 이 단계는 가격·일별 투자자 수급을 확인하는 용도라 계좌번호는 필요하지 않습니다. HTS ID도 필요하지 않습니다.
# 부록의 LECTURE_KIS_MODE는 paper면 demo, real이면 real로 고릅니다.
KIS_PAPER_APP_KEY=""
KIS_PAPER_APP_SECRET=""
KIS_REAL_APP_KEY=""
KIS_REAL_APP_SECRET=""

# ═══════════════════════════════════════════════════════════════
#  STEP 4. 증권사 주문 연결 — 4단계(paper)부터 필요
# ═══════════════════════════════════════════════════════════════
# 여기서는 계좌·주문·체결 확인을 준비합니다.
# 위의 KIS App Key/Secret은 수급 확인과 주문 연결에서 같은 이름을 사용하지만,
# 주문 경로에는 아래 broker 설정과 선택한 환경의 계좌번호가 추가로 필요합니다.
KIS_PAPER_ACCOUNT_NO=""
KIS_PAPER_PRODUCT_CODE="01"
KIS_REAL_ACCOUNT_NO=""
KIS_REAL_PRODUCT_CODE="01"
# 계좌번호 앞 8자리는 ACCOUNT_NO, 뒤 2자리는 PRODUCT_CODE에 입력합니다.
# HTS ID는 이전 주문 모듈을 사용할 때만 필요합니다.
KIS_HTS_ID=""
# 이전 주문 모듈의 선택 설정 (기본 수업 파이프라인의 리스크 상수와는 별개)
# KIS_DEFAULT_BUY_AMOUNT_KRW=10000
# KIS_DEFAULT_BUY_AMOUNT_USD=100
# KIS_AUTO_TRADING=0
# KIS_PAPER_MARKET=all
# KIS_REAL_MARKET=all

# 증권사 선택: kis(한국투자증권, 기본) | kiwoom | toss | custom
LECTURE_BROKER=kis
# 계좌 모드: demo(모의투자) | real(실전투자)
LECTURE_BROKER_MODE=demo

# ⛔ 안전장치 — 이 두 값이 0이면 위에서 뭘 고르든 실제 증권사 주문이
#    나가지 않습니다. 모의투자(demo)도 실제 증권사 API 호출이므로,
#    연습하려면 첫 번째 값을 본인이 직접 1로 바꿔야 합니다.
LECTURE_ENABLE_LIVE_BROKER=0   # 1 = 증권사 API 호출 허용 (모의투자 포함)
LECTURE_ALLOW_REAL_BROKER=0    # 1 = 실전투자(진짜 돈) 허용 — 수업에서는 금지
LECTURE_UNATTENDED_LIVE_ACK=
# 정확히 이 값으로 바꿔야 실전 무인 주문이 허용됩니다: I_ACCEPT_REAL_ORDERS

# KIS 설정은 이 .env 파일에서 관리합니다. 별도 YAML 파일은 필요하지 않습니다.

# ═══════════════════════════════════════════════════════════════
#  부록 — 보통 만질 필요 없는 값들
# ═══════════════════════════════════════════════════════════════

# (1) 세부 스위치: STEP 1의 학습 단계가 아래 값들을 자동으로 정합니다.
#     특정 기능만 따로 켜고 끄고 싶을 때만 # 을 지우고 사용하세요.
# LECTURE_DATA_MODE=mock        # mock | auto | yfinance    : 분석 데이터 원천
# LECTURE_SCREENING_MODE=mock   # mock | real               : 종목 스크리닝 데이터
# LECTURE_LLM_MODE=mock         # mock | auto | oauth | openai : LLM 호출 방식
# LECTURE_REPORT_MODE=lite      # lite | research           : 보고서 깊이
# LECTURE_RESEARCH_TOOLS=""     # perplexity,firecrawl      : 리서치 도구 선택
# LECTURE_TRADE_MODE=simulation # simulation | demo | real  : 매매 실행 수준

# (2) KIS 이전 호환 플래그 (STEP 4의 LECTURE_BROKER 계열과 같은 역할)
LECTURE_KIS_MODE=demo
LECTURE_ENABLE_LIVE_KIS=0
LECTURE_ALLOW_REAL_KIS=0

# (4) 키움증권을 쓸 때 (LECTURE_BROKER=kiwoom)
#     공식 문서 기준: mockapi.kiwoom.com / api.kiwoom.com
# KIWOOM_MODE=demo
# KIWOOM_APP_KEY=""
# KIWOOM_SECRET_KEY=""
# KIWOOM_ACCESS_TOKEN=""
# KIWOOM_EXCHANGE=KRX

# (5) 토스증권을 쓸 때
#     P4-TOSS 읽기 전용 실습은 tossctl 0.43.1 이상의 공식 Open API 경로를 씁니다.
#     토스증권 WTS에서 발급한 키와 허용 IP는 tossctl의 사용자 로컬 설정에만 저장합니다.
#     이 파일에 키·토큰·계좌번호를 적지 마세요. 계좌나 키가 없으면 fixture 검증만 합니다.
#     아래 LECTURE_BROKER=toss 경로는 기존 비공식 WTS 주문 수명주기용이며 수업에서 주문하지 않습니다.
# TOSS_SECURITIES_MODE=real
# TOSSCTL_PATH=""              # tossctl 또는 tossctl.exe 절대 경로
# TOSSCTL_TIMEOUT_SECONDS=15

# (6) 완전히 다른 증권사 어댑터를 직접 만들 때 (LECTURE_BROKER=custom)
# LECTURE_BROKER_ADAPTER=my_broker_module:MyBrokerAdapter
